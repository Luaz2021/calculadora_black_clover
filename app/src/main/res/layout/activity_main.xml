<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/calc_bg"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- 1. BARRA SUPERIOR: BOTON TEMA (OSCURO/CLARO) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end">

        <ImageButton
            android:id="@+id/btnThemeToggle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Modo oscuro"
            android:src="@android:drawable/ic_menu_day" />
    </LinearLayout>

    <!-- 2. PANTALLA: OPERACION Y RESULTADO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/tvOperation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:ellipsize="start"
            android:gravity="end"
            android:singleLine="true"
            android:textColor="@color/calc_display_op"
            android:textSize="22sp"
            tools:text="125 × 4" />

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="start"
            android:gravity="end"
            android:singleLine="true"
            android:text="0"
            android:textColor="@color/calc_display_res"
            android:textSize="50sp"
            android:textStyle="bold"
            tools:text="500" />
    </LinearLayout>

    <!-- 3. TECLADO BASICO (4 columnas x 5 filas) -->
    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:stretchColumns="*">

        <!-- Fila 1: C | DEL | % | ÷ -->
        <TableRow android:layout_weight="1">
            <Button android:id="@+id/btnClear" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="4dp" android:backgroundTint="@color/calc_btn_func_bg" android:text="C" android:textColor="@color/calc_btn_func_text" android:textSize="20sp" />
            <Button android:id="@+id/btnDelete" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="4dp" android:backgroundTint="@color/calc_btn_func_bg" android:text="DEL" android:textColor="@color/calc_btn_func_text" android:textSize="16sp" />
            <Button android:id="@+id/btnPercent" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="4dp" android:backgroundTint="@color/calc_btn_op_bg" android:text="%" android:textColor="@color/calc_btn_op_text" android:textSize="20sp" />
            <Button android:id="@+id/btnDiv" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="4dp" android:backgroundTint="@color/calc_btn_op_bg" android:text="÷" android:textColor="@color/calc_btn_op_text" android:textSize="24sp" />
        </TableRow>

        <!-- Fila 2: 7 | 8 | 9 | × -->
        <TableRow android:layout_weight="1">
            <Button android:id="@+id/btn7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="4dp" android:backgroundTint="@color/calc_btn_num_bg" android:text="7" android:textColor="@color/calc_btn_num_text" android:textSize="22sp" />
            <Button android:id="@+id/btn8" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="4dp" android:backgroundTint="@color/calc_btn_num_bg" android:text="8" android:textColor="@color/calc_btn_num_text" android:textSize="22sp" />
            <Button android:id="@+id/btn9" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="4dp" android:backgroundTint="@color/calc_btn_num_bg" android:text="9" android:textColor="@color/calc_btn_num_text" android:textSize="22sp" />
            <Button android:id="@+id/btnMul" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="4dp" android:backgroundTint="@color/calc_btn_op_bg" android:text="×" android:textColor="@color/calc_btn_op_text" android:textSize="24sp" />
        </TableRow>

        <!-- Fila 3: 4 | 5 | 6 | - -->
        <TableRow android:layout_weight="1">
            <Button android:id="@+id/btn4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="4dp" android:backgroundTint="@color/calc_btn_num_bg" android:text="4" android:textColor="@color/calc_btn_num_text" android:textSize="22sp" />
            <Button android:id="@+id/btn5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="4dp" android:backgroundTint="@color/calc_btn_num_bg" android:text="5" android:textColor="@color/calc_btn_num_text" android:textSize="22sp" />
            <Button android:id="@+id/btn6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="4dp" android:backgroundTint="@color/calc_btn_num_bg" android:text="6" android:textColor="@color/calc_btn_num_text" android:textSize="22sp" />
            <Button android:id="@+id/btnSub" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="4dp" android:backgroundTint="@color/calc_btn_op_bg" android:text="-" android:textColor="@color/calc_btn_op_text" android:textSize="24sp" />
        </TableRow>

        <!-- Fila 4: 1 | 2 | 3 | + -->
        <TableRow android:layout_weight="1">
            <Button android:id="@+id/btn1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="4dp" android:backgroundTint="@color/calc_btn_num_bg" android:text="1" android:textColor="@color/calc_btn_num_text" android:textSize="22sp" />
            <Button android:id="@+id/btn2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="4dp" android:backgroundTint="@color/calc_btn_num_bg" android:text="2" android:textColor="@color/calc_btn_num_text" android:textSize="22sp" />
            <Button android:id="@+id/btn3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="4dp" android:backgroundTint="@color/calc_btn_num_bg" android:text="3" android:textColor="@color/calc_btn_num_text" android:textSize="22sp" />
            <Button android:id="@+id/btnAdd" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="4dp" android:backgroundTint="@color/calc_btn_op_bg" android:text="+" android:textColor="@color/calc_btn_op_text" android:textSize="24sp" />
        </TableRow>

        <!-- Fila 5: ± | 0 | . | = -->
        <TableRow android:layout_weight="1">
            <Button android:id="@+id/btnSign" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="4dp" android:backgroundTint="@color/calc_btn_func_bg" android:text="±" android:textColor="@color/calc_btn_func_text" android:textSize="22sp" />
            <Button android:id="@+id/btn0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="4dp" android:backgroundTint="@color/calc_btn_num_bg" android:text="0" android:textColor="@color/calc_btn_num_text" android:textSize="22sp" />
            <Button android:id="@+id/btnDot" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="4dp" android:backgroundTint="@color/calc_btn_num_bg" android:text="." android:textColor="@color/calc_btn_num_text" android:textSize="24sp" />
            <Button android:id="@+id/btnEqual" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="4dp" android:backgroundTint="@color/calc_btn_eq_bg" android:text="=" android:textColor="@color/calc_btn_eq_text" android:textSize="24sp" />
        </TableRow>
    </TableLayout>
</LinearLayout>
