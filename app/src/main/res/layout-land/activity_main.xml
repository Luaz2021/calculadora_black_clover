<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/calc_bg"
    android:orientation="vertical"
    android:padding="10dp"
    tools:context=".MainActivity">

    <!-- Barra superior + Display -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnThemeToggle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Modo oscuro"
            android:src="@android:drawable/ic_menu_day" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvOperation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="start"
                android:gravity="end"
                android:singleLine="true"
                android:textColor="@color/calc_display_op"
                android:textSize="16sp"
                tools:text="sin(30) + 125" />

            <TextView
                android:id="@+id/tvResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="start"
                android:gravity="end"
                android:singleLine="true"
                android:text="0"
                android:textColor="@color/calc_display_res"
                android:textSize="28sp"
                android:textStyle="bold"
                tools:text="125.5" />
        </LinearLayout>
    </LinearLayout>

    <!-- Teclado Científico + Básico (7 columnas x 5 filas) -->
    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:stretchColumns="*">

        <!-- Fila 1 -->
        <TableRow android:layout_height="0dp" android:layout_weight="1">
            <Button android:id="@+id/btnSin" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:backgroundTint="@color/calc_btn_sci_bg" android:textColor="@color/calc_btn_sci_text" android:text="sin" android:textAllCaps="false" android:textSize="14sp" />
            <Button android:id="@+id/btnCos" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:backgroundTint="@color/calc_btn_sci_bg" android:textColor="@color/calc_btn_sci_text" android:text="cos" android:textAllCaps="false" android:textSize="14sp" />
            <Button android:id="@+id/btnTan" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:backgroundTint="@color/calc_btn_sci_bg" android:textColor="@color/calc_btn_sci_text" android:text="tan" android:textAllCaps="false" android:textSize="14sp" />
            <Button android:id="@+id/btnClear" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:backgroundTint="@color/calc_btn_func_bg" android:textColor="@color/calc_btn_func_text" android:text="C" android:textSize="15sp" />
            <Button android:id="@+id/btnDelete" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:backgroundTint="@color/calc_btn_func_bg" android:textColor="@color/calc_btn_func_text" android:text="DEL" android:textSize="13sp" />
            <Button android:id="@+id/btnPercent" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:backgroundTint="@color/calc_btn_op_bg" android:textColor="@color/calc_btn_op_text" android:text="%" android:textSize="15sp" />
            <Button android:id="@+id/btnDiv" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:backgroundTint="@color/calc_btn_op_bg" android:textColor="@color/calc_btn_op_text" android:text="÷" android:textSize="18sp" />
        </TableRow>

        <!-- Fila 2 -->
        <TableRow android:layout_height="0dp" android:layout_weight="1">
            <Button android:id="@+id/btnLn" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:backgroundTint="@color/calc_btn_sci_bg" android:textColor="@color/calc_btn_sci_text" android:text="ln" android:textAllCaps="false" android:textSize="14sp" />
            <Button android:id="@+id/btnLog" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:backgroundTint="@color/calc_btn_sci_bg" android:textColor="@color/calc_btn_sci_text" android:text="log" android:textAllCaps="false" android:textSize="14sp" />
            <Button android:id="@+id/btnSqrt" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:backgroundTint="@color/calc_btn_sci_bg" android:textColor="@color/calc_btn_sci_text" android:text="√" android:textSize="15sp" />
            <Button android:id="@+id/btn7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:backgroundTint="@color/calc_btn_num_bg" android:textColor="@color/calc_btn_num_text" android:text="7" android:textSize="16sp" />
            <Button android:id="@+id/btn8" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:backgroundTint="@color/calc_btn_num_bg" android:textColor="@color/calc_btn_num_text" android:text="8" android:textSize="16sp" />
            <Button android:id="@+id/btn9" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:backgroundTint="@color/calc_btn_num_bg" android:textColor="@color/calc_btn_num_text" android:text="9" android:textSize="16sp" />
            <Button android:id="@+id/btnMul" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:backgroundTint="@color/calc_btn_op_bg" android:textColor="@color/calc_btn_op_text" android:text="×" android:textSize="18sp" />
        </TableRow>

        <!-- Fila 3 -->
        <TableRow android:layout_height="0dp" android:layout_weight="1">
            <Button android:id="@+id/btnPow2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:backgroundTint="@color/calc_btn_sci_bg" android:textColor="@color/calc_btn_sci_text" android:text="x²" android:textAllCaps="false" android:textSize="14sp" />
            <Button android:id="@+id/btnPowY" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:backgroundTint="@color/calc_btn_sci_bg" android:textColor="@color/calc_btn_sci_text" android:text="xʸ" android:textAllCaps="false" android:textSize="14sp" />
            <Button android:id="@+id/btnFact" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:backgroundTint="@color/calc_btn_sci_bg" android:textColor="@color/calc_btn_sci_text" android:text="n!" android:textAllCaps="false" android:textSize="14sp" />
            <Button android:id="@+id/btn4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:backgroundTint="@color/calc_btn_num_bg" android:textColor="@color/calc_btn_num_text" android:text="4" android:textSize="16sp" />
            <Button android:id="@+id/btn5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:backgroundTint="@color/calc_btn_num_bg" android:textColor="@color/calc_btn_num_text" android:text="5" android:textSize="16sp" />
            <Button android:id="@+id/btn6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:backgroundTint="@color/calc_btn_num_bg" android:textColor="@color/calc_btn_num_text" android:text="6" android:textSize="16sp" />
            <Button android:id="@+id/btnSub" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:backgroundTint="@color/calc_btn_op_bg" android:textColor="@color/calc_btn_op_text" android:text="-" android:textSize="18sp" />
        </TableRow>

        <!-- Fila 4 -->
        <TableRow android:layout_height="0dp" android:layout_weight="1">
            <Button android:id="@+id/btnOpenParen" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:backgroundTint="@color/calc_btn_sci_bg" android:textColor="@color/calc_btn_sci_text" android:text="(" android:textSize="15sp" />
            <Button android:id="@+id/btnCloseParen" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:backgroundTint="@color/calc_btn_sci_bg" android:textColor="@color/calc_btn_sci_text" android:text=")" android:textSize="15sp" />
            <Button android:id="@+id/btnPi" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:backgroundTint="@color/calc_btn_sci_bg" android:textColor="@color/calc_btn_sci_text" android:text="π" android:textSize="15sp" />
            <Button android:id="@+id/btn1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:backgroundTint="@color/calc_btn_num_bg" android:textColor="@color/calc_btn_num_text" android:text="1" android:textSize="16sp" />
            <Button android:id="@+id/btn2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:backgroundTint="@color/calc_btn_num_bg" android:textColor="@color/calc_btn_num_text" android:text="2" android:textSize="16sp" />
            <Button android:id="@+id/btn3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:backgroundTint="@color/calc_btn_num_bg" android:textColor="@color/calc_btn_num_text" android:text="3" android:textSize="16sp" />
            <Button android:id="@+id/btnAdd" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:backgroundTint="@color/calc_btn_op_bg" android:textColor="@color/calc_btn_op_text" android:text="+" android:textSize="18sp" />
        </TableRow>

        <!-- Fila 5 -->
        <TableRow android:layout_height="0dp" android:layout_weight="1">
            <Button android:id="@+id/btnE" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:backgroundTint="@color/calc_btn_sci_bg" android:textColor="@color/calc_btn_sci_text" android:text="e" android:textAllCaps="false" android:textSize="15sp" />
            <Button android:id="@+id/btnInv" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:backgroundTint="@color/calc_btn_sci_bg" android:textColor="@color/calc_btn_sci_text" android:text="1/x" android:textAllCaps="false" android:textSize="13sp" />
            <Button android:id="@+id/btnAbs" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:backgroundTint="@color/calc_btn_sci_bg" android:textColor="@color/calc_btn_sci_text" android:text="|x|" android:textAllCaps="false" android:textSize="14sp" />
            <Button android:id="@+id/btnSign" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:backgroundTint="@color/calc_btn_func_bg" android:textColor="@color/calc_btn_func_text" android:text="±" android:textSize="16sp" />
            <Button android:id="@+id/btn0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:backgroundTint="@color/calc_btn_num_bg" android:textColor="@color/calc_btn_num_text" android:text="0" android:textSize="16sp" />
            <Button android:id="@+id/btnDot" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:backgroundTint="@color/calc_btn_num_bg" android:textColor="@color/calc_btn_num_text" android:text="." android:textSize="18sp" />
            <Button android:id="@+id/btnEqual" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="2dp" android:backgroundTint="@color/calc_btn_eq_bg" android:textColor="@color/calc_btn_eq_text" android:text="=" android:textSize="18sp" />
        </TableRow>
    </TableLayout>
</LinearLayout>
